+#pragma once
+
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include "libfairino/include/robot.h"
+
+namespace fairino_hardware
+{
+// Both plugins are built into libfairino_hardware. This inline function's
+// static registry is shared across their translation units, not across processes.
+// The launch file must continue to use one process per robot controller.
+struct SharedRobotConnection
+{
+    FRRobot robot;
+    std::mutex mutex;
+    std::string ip;
+
+    explicit SharedRobotConnection(const std::string & address) : ip(address) {}
+    ~SharedRobotConnection()
+    {
+        try { robot.CloseRPC(); } catch (...) { /* Never throw from cleanup. */ }
+    }
+};
+
+inline std::shared_ptr<SharedRobotConnection> acquire_robot_connection(
+    const std::string & ip)
+{
+    static std::mutex registry_mutex;
+    static std::weak_ptr<SharedRobotConnection> registry;
+    std::lock_guard<std::mutex> lock(registry_mutex);
+    if (auto current = registry.lock()) {
+        if (current->ip != ip) {
+            throw std::runtime_error(
+                "Different robot IPs in one SDK process; use one controller_manager per arm");
+        }
+        return current;
+    }
+    if (ip.empty()) throw std::runtime_error("Missing robot_ip");
+    auto connection = std::make_shared<SharedRobotConnection>(ip);
+    const int code = connection->robot.RPC(ip.c_str());
+    if (code != 0) {
+        throw std::runtime_error("RPC(" + ip + ") failed, code=" + std::to_string(code));
+    }
+    registry = connection;
+    return connection;
+}
+}  // namespace fairino_hardware
