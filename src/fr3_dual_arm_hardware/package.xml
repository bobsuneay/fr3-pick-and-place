<?xml version="1.0"?>
<package format="3">
  <name>fr3_dual_arm_hardware</name>
  <version>0.1.0</version>
  <description>ros2_control hardware interface adapter for two FAIRINO FR3 arms and HKV grippers.</description>
  <maintainer email="maintainer@example.com">FR3 dual-arm maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>controller_manager</depend>
  <depend>launch_ros</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
