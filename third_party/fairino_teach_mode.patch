+hardware_interface::return_type FairinoHardwareInterface::perform_command_mode_switch(
+    const std::vector<std::string> & start_interfaces,
+    const std::vector<std::string> & stop_interfaces)
+{
+    // All hardware components see all keys; only react to our own joints.
+    for (const auto & joint : info_.joints) {
+        const auto key = joint.name + "/position";
+        if (std::find(stop_interfaces.begin(), stop_interfaces.end(), key) != stop_interfaces.end())
+            command_claimed_ = false;
+    }
+    std::size_t starting = 0;
+    for (const auto & joint : info_.joints) {
+        const auto key = joint.name + "/position";
+        if (std::find(start_interfaces.begin(), start_interfaces.end(), key) != start_interfaces.end())
+            ++starting;
+    }
+    if (starting && starting != 6) return hardware_interface::return_type::ERROR;
+    if (starting) {
+        // Reseed commands after hand-guiding; never replay the pre-teach target.
+        for (std::size_t i = 0; i < 6; ++i) {
+            if (!std::isfinite(_jnt_position_state[i])) return hardware_interface::return_type::ERROR;
+            _jnt_position_command[i] = _jnt_position_state[i];
+        }
+        command_claimed_ = true;
+    }
+    return hardware_interface::return_type::OK;
+}
