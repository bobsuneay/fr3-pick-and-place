<?xml version="1.0" encoding="UTF-8"?>
<robot name="fr3_dual_arm">
  <group name="left_arm">
    <chain base_link="left_base_link" tip_link="left_gripper_tcp"/>
  </group>
  <group name="right_arm">
    <chain base_link="right_base_link" tip_link="right_gripper_tcp"/>
  </group>
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>
  <group name="left_gripper">
    <joint name="left_left_finger_joint"/>
    <joint name="left_right_finger_joint"/>
  </group>
  <group name="right_gripper">
    <joint name="right_left_finger_joint"/>
    <joint name="right_right_finger_joint"/>
  </group>

  <end_effector name="left_hkv" parent_link="left_gripper_palm" group="left_gripper" parent_group="left_arm"/>
  <end_effector name="right_hkv" parent_link="right_gripper_palm" group="right_gripper" parent_group="right_arm"/>

  <group_state name="ready" group="left_arm">
    <joint name="left_j1" value="0.0175"/>
    <joint name="left_j2" value="-1.0472"/>
    <joint name="left_j3" value="1.5533"/>
    <joint name="left_j4" value="-0.8727"/>
    <joint name="left_j5" value="-0.7854"/>
    <joint name="left_j6" value="-0.5760"/>
  </group_state>
  <group_state name="ready" group="right_arm">
    <joint name="right_j1" value="-1.6057"/>
    <joint name="right_j2" value="-2.2864"/>
    <joint name="right_j3" value="-1.3963"/>
    <joint name="right_j4" value="-2.4958"/>
    <joint name="right_j5" value="0.6458"/>
    <joint name="right_j6" value="-1.5533"/>
  </group_state>

  <group_state name="open" group="left_gripper">
    <joint name="left_left_finger_joint" value="0.03"/>
    <joint name="left_right_finger_joint" value="0.03"/>
  </group_state>
  <group_state name="open" group="right_gripper">
    <joint name="right_left_finger_joint" value="0.03"/>
    <joint name="right_right_finger_joint" value="0.03"/>
  </group_state>
  <group_state name="closed" group="left_gripper">
    <joint name="left_left_finger_joint" value="0.002"/>
    <joint name="left_right_finger_joint" value="0.002"/>
  </group_state>
  <group_state name="closed" group="right_gripper">
    <joint name="right_left_finger_joint" value="0.002"/>
    <joint name="right_right_finger_joint" value="0.002"/>
  </group_state>

  <disable_collisions link1="left_mount_plate" link2="left_base_link" reason="Mounting"/>
  <disable_collisions link1="right_mount_plate" link2="right_base_link" reason="Mounting"/>
  <disable_collisions link1="left_wrist3_link" link2="left_gripper_palm" reason="Mounting"/>
  <disable_collisions link1="right_wrist3_link" link2="right_gripper_palm" reason="Mounting"/>
  <disable_collisions link1="head_bracket" link2="head_camera_link" reason="Mounting"/>
</robot>
